{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
  },
  "references": [
    { "path": "../../packages/core" }
  ],
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
  // Pillar B render scaffolding is test-only and reaches across the repo root
  // into tests/perf via the vitest `@perf` alias, which the production tsc build does
  // not (and should not) resolve. It is validated by running under vitest, exactly like
  // the rest of tests/perf — keep it out of the app's production type-check.
  "exclude": ["src/**/__perf__/**"]
}
